using Gtk 4.0;
using Adw 1;

template $ArmariumWindow: Adw.ApplicationWindow {
  default-width: 1100;
  default-height: 760;
  title: _("Armarium");

  content: Adw.ToastOverlay toast_overlay {
    child: Adw.ToolbarView {
      [top]
      Adw.HeaderBar {
        [start]
        Adw.SplitButton {
          label: _("_Import");
          use-underline: true;
          tooltip-text: _("Import Files");
          action-name: "win.import-files";
          menu-model: import_menu;
          dropdown-tooltip: _("More Import Options");
        }

        [start]
        Gtk.MenuButton {
          icon-name: "view-sort-descending-symbolic";
          menu-model: sort_menu;
          tooltip-text: _("Sort");
        }

        [start]
        Gtk.Box device_indicator {
          spacing: 6;
          margin-start: 6;
          visible: false;

          Gtk.Image {
            icon-name: "drive-removable-media-symbolic";
          }

          Gtk.Label device_name {}

          Gtk.Label device_free {
            styles [
              "dimmed",
            ]
          }

          Gtk.Button device_eject {
            icon-name: "media-eject-symbolic";
            action-name: "win.eject-device";

            styles [
              "flat",
            ]
          }
        }

        title-widget: Gtk.SearchEntry search_entry {
          placeholder-text: _("Search title, author or series");
          width-request: 360;
        };

        [end]
        Gtk.MenuButton {
          icon-name: "open-menu-symbolic";
          menu-model: primary_menu;
          primary: true;
          tooltip-text: _("Main Menu");
        }

        [end]
        Adw.ToggleGroup view_toggle {
          active-name: "grid";

          Adw.Toggle {
            name: "grid";
            icon-name: "view-grid-symbolic";
            tooltip: _("Grid View");
          }

          Adw.Toggle {
            name: "list";
            icon-name: "view-list-symbolic";
            tooltip: _("List View");
          }

          styles [
            "flat",
          ]
        }
      }

      content: Adw.OverlaySplitView split_view {
        sidebar-position: end;
        show-sidebar: false;
        min-sidebar-width: 300;
        max-sidebar-width: 380;

        content: $ArmariumSteadyContent {
          child: Gtk.Overlay {
            child: Gtk.Stack stack {
              transition-type: crossfade;

              Gtk.StackPage {
                name: "empty";

                child: Adw.StatusPage {
                  icon-name: "accessories-dictionary-symbolic";
                  title: _("No Books Yet");
                  description: _("Import EPUB or PDF files, or drop them here");

                  child: Gtk.Button {
                    label: _("_Import Books…");
                    use-underline: true;
                    action-name: "win.import-files";
                    halign: center;

                    styles [
                      "pill",
                      "suggested-action",
                    ]
                  };
                };
              }

              Gtk.StackPage {
                name: "no-results";

                child: Adw.StatusPage {
                  icon-name: "system-search-symbolic";
                  title: _("No Results");
                  description: _("Try a different search");
                };
              }

              Gtk.StackPage {
                name: "grid";

                child: Gtk.ScrolledWindow {
                  hscrollbar-policy: never;

                  child: Gtk.GridView grid_view {
                    max-columns: 32;
                    single-click-activate: false;

                    styles [
                      "book-grid",
                    ]
                  };
                };
              }

              Gtk.StackPage {
                name: "list";

                child: Gtk.ScrolledWindow {
                  child: Gtk.ColumnView column_view {
                    reorderable: false;
                    show-row-separators: true;

                    styles [
                      "book-list",
                    ]
                  };
                };
              }
            };

            [overlay]
            Gtk.ProgressBar progress_bar {
              valign: start;
              visible: false;

              styles [
                "osd",
              ]
            }
          };
        };

        sidebar: $ArmariumBookDetails details {};
      };
    };
  };
}

menu import_menu {
  section {
    item {
      label: _("Import _Folder…");
      action: "win.import-folder";
    }
  }
}

menu sort_menu {
  section {
    label: _("Sort By");

    item {
      label: _("_Title");
      action: "win.sort-by";
      target: "title";
    }

    item {
      label: _("_Authors");
      action: "win.sort-by";
      target: "authors";
    }

    item {
      label: _("_Series");
      action: "win.sort-by";
      target: "series";
    }

    item {
      label: _("_Formats");
      action: "win.sort-by";
      target: "formats";
    }

    item {
      label: _("_Date Added");
      action: "win.sort-by";
      target: "date-added";
    }
  }

  section {
    label: _("Order");

    item {
      label: _("A_scending");
      action: "win.sort-order";
      target: "ascending";
    }

    item {
      label: _("D_escending");
      action: "win.sort-order";
      target: "descending";
    }
  }
}

menu primary_menu {
  section {
    item {
      label: _("_Preferences");
      action: "win.preferences";
    }

    item {
      label: _("_About Armarium");
      action: "app.about";
    }
  }
}
